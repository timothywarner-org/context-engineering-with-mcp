# Build output, installed packages, and caches regenerate from the lock files.
node_modules/
dist/
__pycache__/
.venv/

# Generated client configs contain absolute paths from one machine.
clients/generated/

# Demo databases and secrets never belong in a teaching repo.
*.db
*.sqlite3
.env
.env.*

# verify_protocol.py writes fresh evidence here on every run; the reference copy lives in evidence/.
/protocol-evidence.json

# Publisher submissions, correspondence, source snapshots, and rehearsal receipts
# share the working folder without becoming public repository content.
.local/
*.pem
*.key

# Agent coordination notes stay local to the instructor checkout.
/COORDINATION.md
